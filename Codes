import numpy as np, pandas as pd, scipy.sparse as sp
from sklearn.decomposition import TruncatedSVD
from sklearn.preprocessing import normalize
import lightgbm as lgb

np.random.seed(42)

n_users, n_items, n_cat = 2000, 1000, 10

# Item features
item_cat   = np.random.randint(0, n_cat, n_items)
item_price = np.random.lognormal(3, 0.6, n_items)
item_pop   = np.random.pareto(1.2, n_items) + 1
item_pop  /= item_pop.sum()

# User preferences (hidden taste per user)
user_pref  = np.random.dirichlet(np.ones(n_cat) * 0.3, n_users)

rows = []
for u in range(n_users):
    # Number of events per user
    n = np.random.randint(15, 60)
    # Probability distribution of items based on overall popularity and user's category preference
    p = item_pop * user_pref[u][item_cat]
    p /= p.sum()
    # Sample items, days, and event types
    items = np.random.choice(n_items, n, p=p)
    days  = np.sort(np.random.randint(0, 90, n))
    evs   = np.random.choice(["view", "cart", "buy"], n, p=[0.7, 0.2, 0.1])
    rows += [(u, i, d, e) for i, d, e in zip(items, days, evs)]

# Create DataFrame
df = pd.DataFrame(rows, columns=["user", "item", "day", "event"])
# Assign implicit feedback strength to events
df["weight"] = df.event.map({"view": 1, "cart": 3, "buy": 5}) # implicit feedback strength

print("DataFrame shape:", df.shape)
print("First 5 rows of the generated data:")
display(df.head())

def recall_at_k(recs, truth, k):
    """Calculates Recall@K."""
    # Ensure truth[u] is not empty to avoid division by zero for some users
    return np.mean([len(set(recs.get(u, [])[:k]) & truth[u]) / len(truth[u]) for u in truth if len(truth[u]) > 0])

def ndcg_at_k(recs, truth, k):
    """Calculates NDCG@K."""
    out = []
    for u in truth:
        if len(truth[u]) == 0: # Skip users with no relevant items
            continue
        r = recs.get(u, [])[:k]
        dcg  = sum(1 / np.log2(i + 2) for i, it in enumerate(r) if it in truth[u])
        # Ideal DCG for the current user up to k items
        idcg_denom = [1 / np.log2(i + 2) for i in range(min(k, len(truth[u])))]
        idcg = sum(idcg_denom) if idcg_denom else 0.0
        out.append(dcg / idcg if idcg > 0 else 0.0)
    return np.mean(out)

def evaluate(name, recs, truth):
    """Prints Recall@20 and NDCG@10 for a given set of recommendations and truth."""
    print(f"{name:20s} Recall@20 = {recall_at_k(recs, truth, 20):.4f} | NDCG@10 = {ndcg_at_k(recs, truth, 10):.4f}")

def make_truth(hist, label_df):
    """Ground truth = cart/buy items in the label window the user has not seen before."""
    # Items seen by each user in the history window
    seen = hist.groupby("user").item.apply(set).to_dict()
    # Items that are 'cart' or 'buy' events in the label window
    t = label_df[label_df.weight >= 3].groupby("user").item.apply(set).to_dict()
    # Filter out items from the ground truth that were already seen in the history
    t = {u: {i for i in s if i not in seen.get(u, set())} for u, s in t.items()}
    # Return only users who have relevant unseen items
    return seen, {u: s for u, s in t.items() if s}

def fit_scores(hist):
    """Fits collaborative filtering and matrix factorization models based on historical interactions."""
    # Create a user-item interaction matrix
    R = sp.csr_matrix((hist.weight, (hist.user, hist.item)), shape=(n_users, n_items))

    # Item popularity based on total interaction weight
    pop = np.asarray(R.sum(0)).ravel()

    # Item-item Collaborative Filtering (cosine similarity)
    Rn = normalize(R, axis=0) # Normalize by column (item)
    sim = (Rn.T @ Rn).toarray()
    np.fill_diagonal(sim, 0) # Remove self-similarity
    S_cf = np.asarray(R @ sim) # User-item CF scores

    # Matrix Factorization using Truncated SVD
    svd = TruncatedSVD(n_components=32, random_state=42)
    U = svd.fit_transform(R) # User factors
    S_mf = U @ svd.components_ # Reconstructed user-item scores
    return pop, S_cf, S_mf

def build(hist, label_df, K=100):
    """Builds candidate table with features and labels for a given history/label window."""
    pop, S_cf, S_mf = fit_scores(hist)
    seen, truth = make_truth(hist, label_df)

    # Prepare item-related features for history (category and price)
    h = hist.assign(cat=item_cat[hist.item.values], price=item_price[hist.item.values])

    # Calculate user category affinity
    aff = np.zeros((n_users, n_cat))
    np.add.at(aff, (h.user.values, h.cat.values), h.weight.values)
    aff = aff / np.maximum(aff.sum(1, keepdims=True), 1e-9) # Normalize to get proportions

    # Calculate average price seen by each user
    uprice = h.groupby("user").price.mean().reindex(range(n_users)).fillna(item_price.mean()).values

    # Calculate recent popularity (last 14 days)
    recent = (hist[hist.day >= hist.day.max() - 14].groupby("item").weight.sum()
              .reindex(range(n_items)).fillna(0).values)

    parts = []
    for u in range(n_users):
        # Mask items already seen by the user to exclude them from candidate generation scores
        mask = np.zeros(n_items, bool)
        mask[list(seen.get(u, []))] = True

        # Get MF and CF scores for the current user, apply mask
        a = S_mf[u].copy(); a[mask] = -np.inf
        b = S_cf[u].copy(); b[mask] = -np.inf

        # Generate candidates by taking top K from MF and CF and combining them
        cand = np.union1d(np.argsort(-a)[:K], np.argsort(-b)[:K])
        parts.append(pd.DataFrame({"user": u, "item": cand}))

    # Concatenate candidates for all users
    d = pd.concat(parts, ignore_index=True)

    # Add features to the candidate table
    u_, i_ = d.user.values, d.item.values
    d["mf"] = S_mf[u_, i_]
    d["cf"] = S_cf[u_, i_]
    d["pop"] = pop[i_]
    d["recent"] = recent[i_]
    d["cat"] = item_cat[i_]
    d["price"] = item_price[i_]
    d["cat_aff"] = aff[u_, item_cat[i_]]
    d["price_ratio"] = d.price / uprice[u_]

    # Add binary label: 1 if item is in truth set, 0 otherwise
    d["label"] = [int(i in truth.get(u, ())) for u, i in zip(u_, i_)]
    return d, truth

# Build training data and truth
d_tr, truth_tr = build(df[df.day < 60], df[(df.day >= 60) & (df.day < 75)])

# Build test data and truth
d_te, truth_te = build(df[df.day < 75], df[df.day >= 75])

print("Candidates per user (test set):", round(len(d_te) / n_users, 1))
print("Candidate recall ceiling (proportion of true positives covered by candidates):",
      round(d_te.label.sum() / sum(len(v) for v in truth_te.values()), 4))

print("\nFirst 5 rows of training candidates:")
display(d_tr.head())

feats = ["mf", "cf", "pop", "recent", "cat", "price", "cat_aff", "price_ratio"]

# Filter training data to include only users present in the ground truth
train = d_tr[d_tr.user.isin(truth_tr.keys())].sort_values("user")

# Get group sizes for LambdaRank (number of candidates per user)
groups = train.groupby("user").size().values

# Initialize and train the LightGBM ranker
ranker = lgb.LGBMRanker(objective="lambdarank", n_estimators=200, learning_rate=0.05,
                        num_leaves=31, min_child_samples=20, verbose=-1, random_state=42)

# Check if there is enough data to train the ranker
if len(train) > 0 and len(groups) > 0:
    ranker.fit(train[feats], train.label, group=groups)
    print("Feature importances from LightGBM ranker:")
    display(pd.Series(ranker.feature_importances_, index=feats).sort_values(ascending=False))
else:
    print("Not enough training data available to train the ranker.")
    ranker = None # Ensure ranker is None if training failed

def recs_from(d, col):
    """Generates a dictionary of recommendations (item lists) per user from a DataFrame."""
    d = d.sort_values(["user", col], ascending=[True, False])
    return d.groupby("user").item.apply(list).to_dict()

# Evaluate if the ranker was successfully trained
if ranker is not None:
    # Predict scores for the test candidates using the trained ranker
    d_te["ranker"] = ranker.predict(d_te[feats])

    print("\n--- Evaluation Results ---")
    # Evaluate each recommendation approach
    for col, name in [("pop", "Popularity"), ("cf", "Item-item CF"),
                      ("mf", "SVD matrix fact."), ("ranker", "LightGBM ranker")]:
        evaluate(name, recs_from(d_te, col), truth_te)
else:
    print("Ranker was not trained, skipping evaluation.")

def build_enhanced(hist, label_df, K=100):
    pop, S_cf, S_mf = fit_scores(hist)
    seen, truth = make_truth(hist, label_df)

    # Prepare item-related features for history (category and price)
    h = hist.assign(cat=item_cat[hist.item.values], price=item_price[hist.item.values])

    # Calculate user category affinity
    aff = np.zeros((n_users, n_cat))
    np.add.at(aff, (h.user.values, h.cat.values), h.weight.values)
    aff = aff / np.maximum(aff.sum(1, keepdims=True), 1e-9)

    # User average price and standard deviation
    uprice = h.groupby("user").price.mean().reindex(range(n_users)).fillna(item_price.mean()).values
    uprice_std = h.groupby("user").price.std().reindex(range(n_users)).fillna(0.0).values

    # Calculate recent popularity (last 14 days)
    recent = (hist[hist.day >= hist.day.max() - 14].groupby("item").weight.sum()
              .reindex(range(n_items)).fillna(0).values)

    # User total interaction count
    user_activity = hist.groupby("user").size().reindex(range(n_users)).fillna(0).values

    parts = []
    for u in range(n_users):
        mask = np.zeros(n_items, bool)
        mask[list(seen.get(u, []))] = True

        a = S_mf[u].copy(); a[mask] = -np.inf
        b = S_cf[u].copy(); b[mask] = -np.inf

        # Retrieve top K * 1.5 candidates to increase potential recall before filtering
        cand = np.union1d(np.argsort(-a)[:int(K*1.5)], np.argsort(-b)[:int(K*1.5)])
        parts.append(pd.DataFrame({"user": u, "item": cand}))

    d = pd.concat(parts, ignore_index=True)
    u_, i_ = d.user.values, d.item.values

    # Basic features
    d["mf"] = S_mf[u_, i_]
    d["cf"] = S_cf[u_, i_]
    d["pop"] = pop[i_]
    d["recent"] = recent[i_]
    d["cat"] = item_cat[i_]
    d["price"] = item_price[i_]
    d["cat_aff"] = aff[u_, item_cat[i_]]
    d["price_ratio"] = d.price / uprice[u_]

    # New advanced features
    d["user_activity"] = user_activity[u_]
    d["price_diff_std"] = np.abs(d.price - uprice[u_]) / (uprice_std[u_] + 1e-9)
    d["score_blend"] = d["cf"] * 0.7 + d["mf"] * 0.3

    # Add binary label
    d["label"] = [int(i in truth.get(u, ())) for u, i in zip(u_, i_)]
    return d, truth

# Rebuild candidates with enhanced features
d_tr_enh, truth_tr_enh = build_enhanced(df[df.day < 60], df[(df.day >= 60) & (df.day < 75)])
d_te_enh, truth_te_enh = build_enhanced(df[df.day < 75], df[df.day >= 75])

enhanced_feats = ["mf", "cf", "pop", "recent", "cat", "price", "cat_aff", "price_ratio", "user_activity", "price_diff_std", "score_blend"]

train_enh = d_tr_enh[d_tr_enh.user.isin(truth_tr_enh.keys())].sort_values("user")
groups_enh = train_enh.groupby("user").size().values

# Advanced LGBMRanker with tuned hyperparams
enhanced_ranker = lgb.LGBMRanker(
    objective="lambdarank",
    n_estimators=300,
    learning_rate=0.03,
    num_leaves=63,
    max_depth=6,
    subsample=0.8,
    colsample_bytree=0.8,
    min_child_samples=15,
    verbose=-1,
    random_state=42
)

enhanced_ranker.fit(train_enh[enhanced_feats], train_enh.label, group=groups_enh)

# Evaluate the enhanced version
d_te_enh["enhanced_ranker"] = enhanced_ranker.predict(d_te_enh[enhanced_feats])

print("\n--- Enhanced Evaluation Results ---")
evaluate("Enhanced LGBM Ranker", recs_from(d_te_enh, "enhanced_ranker"), truth_te_enh)

def build_ultra_enhanced(hist, label_df, K=100):
    pop, S_cf, S_mf = fit_scores(hist)
    seen, truth = make_truth(hist, label_df)

    # 1. Apply Exponential Time-Decay to interaction weights
    max_day = hist.day.max()
    # half-life of 20 days
    decay_factor = np.exp(-0.03 * (max_day - hist.day.values))
    hist_decayed = hist.assign(
        weight=hist.weight.values * decay_factor,
        cat=item_cat[hist.item.values],
        price=item_price[hist.item.values]
    )

    # 2. Re-calculate affinities with time-decayed weights
    aff = np.zeros((n_users, n_cat))
    np.add.at(aff, (hist_decayed.user.values, hist_decayed.cat.values), hist_decayed.weight.values)
    aff = aff / np.maximum(aff.sum(1, keepdims=True), 1e-9)

    # Category-specific median price for scaling
    cat_median_prices = pd.DataFrame({'price': item_price, 'cat': item_cat}).groupby('cat').price.median().to_dict()

    uprice = hist_decayed.groupby("user").price.mean().reindex(range(n_users)).fillna(item_price.mean()).values
    uprice_std = hist_decayed.groupby("user").price.std().reindex(range(n_users)).fillna(0.0).values
    user_activity = hist_decayed.groupby("user").size().reindex(range(n_users)).fillna(0).values

    parts = []
    for u in range(n_users):
        mask = np.zeros(n_items, bool)
        mask[list(seen.get(u, []))] = True

        a = S_mf[u].copy(); a[mask] = -np.inf
        b = S_cf[u].copy(); b[mask] = -np.inf

        # Union top candidates
        cand = np.union1d(np.argsort(-a)[:int(K*1.5)], np.argsort(-b)[:int(K*1.5)])
        parts.append(pd.DataFrame({"user": u, "item": cand}))

    d = pd.concat(parts, ignore_index=True)
    u_, i_ = d.user.values, d.item.values

    # Assemble Features
    d["mf"] = S_mf[u_, i_]
    d["cf"] = S_cf[u_, i_]
    d["pop"] = pop[i_]
    d["cat"] = item_cat[i_]
    d["price"] = item_price[i_]
    d["cat_aff"] = aff[u_, item_cat[i_]]
    d["price_ratio"] = d.price / uprice[u_]
    d["user_activity"] = user_activity[u_]
    d["price_diff_std"] = np.abs(d.price - uprice[u_]) / (uprice_std[u_] + 1e-9)
    d["score_blend"] = d["cf"] * 0.7 + d["mf"] * 0.3

    # 3. New cross-feature: Category-relative price ratio
    item_cat_medians = np.array([cat_median_prices[c] for c in item_cat])
    d["cat_relative_price"] = d.price / item_cat_medians[i_]

    d["label"] = [int(i in truth.get(u, ())) for u, i in zip(u_, i_)]
    return d, truth

# Rebuild candidates with ultra features
d_tr_ultra, truth_tr_ultra = build_ultra_enhanced(df[df.day < 60], df[(df.day >= 60) & (df.day < 75)])
d_te_ultra, truth_te_ultra = build_ultra_enhanced(df[df.day < 75], df[df.day >= 75])

ultra_feats = ["mf", "cf", "pop", "cat", "price", "cat_aff", "price_ratio", "user_activity", "price_diff_std", "score_blend", "cat_relative_price"]

train_ultra = d_tr_ultra[d_tr_ultra.user.isin(truth_tr_ultra.keys())].sort_values("user")
groups_ultra = train_ultra.groupby("user").size().values

ultra_ranker = lgb.LGBMRanker(
    objective="lambdarank",
    n_estimators=350,
    learning_rate=0.03,
    num_leaves=63,
    max_depth=7,
    subsample=0.85,
    colsample_bytree=0.85,
    min_child_samples=15,
    verbose=-1,
    random_state=42
)

ultra_ranker.fit(train_ultra[ultra_feats], train_ultra.label, group=groups_ultra)

# Evaluate the ultra version
d_te_ultra["ultra_ranker"] = ultra_ranker.predict(d_te_ultra[ultra_feats])

print("\n--- Ultra Evaluation Results ---")
evaluate("Ultra LGBM Ranker", recs_from(d_te_ultra, "ultra_ranker"), truth_te_ultra)

def recommend(user_id, n=10):
    """Generates top N recommendations for a given user."""
    if ranker is None:
        print("Ranker is not available. Cannot generate recommendations.")
        return pd.DataFrame()

    # Filter test candidates for the specific user and sort by ranker score
    x = d_te[d_te.user == user_id].sort_values("ranker", ascending=False).head(n)

    # Return selected item features and ranker score
    return x[["item", "cat", "price", "ranker"]].round(2).reset_index(drop=True)

print("Recommendations for user_id=5:")
display(recommend(user_id=5))

print("Recommendations for user_id=10:")
display(recommend(user_id=10))

